{
    "Format": "2.9.0",
    "ConfigSchema": {
        "Barn Floor": {
            "AllowValues": "Clean, Cozy",
            "Description": "Houses 48 barn-dwelling animals.",
            "Default": "Clean",
            "Section": "Indoor Appearance"
        },
        "Coop Floor": {
            "AllowValues": "Clean, Cozy",
            "Description": "Houses 48 coop-dwelling animals.",
            "Default": "Clean",
            "Section": "Indoor Appearance"
        },
        "Ultimate Building Upgrade": {
            "AllowValues": "Mega, Giga, More Upgrades, Vanilla, None",
            "Description": "Changes take effect after reloading the save file.",
            "Default": "Giga",
            "Section": "Upgrade Path"
        },
        "SVE Integration": {
            "AllowValues": "true, false",
            "Description": "Toggles compatibility with SVE buildings.",
            "Default": "true",
            "Section": "Upgrade Path"
        }
    },
    "Changes": [
        {
            "Action": "Load",
            "Target": "Maps/ultimate_Clean_UltimateBarn",
            "FromFile": "assets/clean_UltimateBarn.tmx"
        },
        {
            "Action": "Load",
            "Target": "Maps/ultimate_Clean_UltimateCoop",
            "FromFile": "assets/clean_UltimateCoop.tmx"
        },
        {
            "Action": "Load",
            "Target": "Maps/ultimate_Cozy_UltimateBarn",
            "FromFile": "assets/cozy_UltimateBarn.tmx"
        },
        {
            "Action": "Load",
            "Target": "Maps/ultimate_Cozy_UltimateCoop",
            "FromFile": "assets/cozy_UltimateCoop.tmx"
        },
        {
            "Action": "Load",
            "Target": "Maps/ultimate_Clean_SuperDenseBarn",
            "FromFile": "assets/clean_SuperDenseBarn.tmx"
        },
        {
            "Action": "Load",
            "Target": "Maps/ultimate_Clean_SuperDenseCoop",
            "FromFile": "assets/clean_SuperDenseCoop.tmx"
        },
        {
            "Action": "Load",
            "Target": "Maps/ultimate_Cozy_SuperDenseBarn",
            "FromFile": "assets/cozy_SuperDenseBarn.tmx"
        },
        {
            "Action": "Load",
            "Target": "Maps/ultimate_Cozy_SuperDenseCoop",
            "FromFile": "assets/cozy_SuperDenseCoop.tmx"
        },
        {
            "Action": "EditData",
            "Target": "Data/PaintData",
            "Entries": {
                "{{ModId}}_UltimateBarn": "Building/-10 0/Roof/-10 5/Trim/-5 0"
            }
        },
        {
            "Action": "EditData",
            "Target": "Data/PaintData",
            "Entries": {
                "{{ModId}}_UltimateCoop": "Building/-12 0/Roof/-10 5/Trim/-10 5"
            }
        },
        {
            "Action": "EditData",
            "Target": "Data/PaintData",
            "Entries": {
                "{{ModId}}_SuperDenseBarn": "Building/-15 0/Roof/-10 5/Trim/-10 5"
            }
        },
        {
            "Action": "EditData",
            "Target": "Data/PaintData",
            "Entries": {
                "{{ModId}}_SuperDenseCoop": "Building/-25 0/Roof/-15 5/Trim/-25 0"
            }
        },
        {
            "Action": "Include",
            "FromFile": "data/includeVPP.json",
            "When": {
                "HasMod": "KediDili.VanillaPlusProfessions"
            }
        },
        {
            "Action": "Include",
            "FromFile": "data/upgradeSVE.json",
            "When": {
                "bobkalonger.UltCB_code/SVEIntegration": "true",
                "HasMod": "FlashShifter.StardewValleyExpandedCP"
            }
        },
        {
            "Action": "Include",
            "FromFile": "data/upgradeBOTI.json",
            "When": {
                "bobkalonger.UltCB_code/SVEIntegration": "hasBOTI",
                "HasMod": "bobkalonger.UltCB_code"
            }
        },
        {
            "Action": "Include",
            "FromFile": "data/upgradeGiga.json",
            "When": {
                "bobkalonger.UltCB_code/UltimateMode": "Giga",
                "HasMod": "bobkalonger.UltCB_code"
            }
        },
        {
            "Action": "Include",
            "FromFile": "data/upgradeBoth.json",
            "When": {
                "bobkalonger.UltCB_code/UltimateMode": "Both",
                "HasMod": "bobkalonger.UltCB_code"
            }
        },
        {
            "Action": "Include",
            "FromFile": "data/upgradeMega.json",
            "When": {
                "bobkalonger.UltCB_code/UltimateMode": "Mega",
                "HasMod": "bobkalonger.UltCB_code"
            }
        },
        {
            "Action": "Include",
            "FromFile": "data/upgradeGiant.json",
            "When": {
                "bobkalonger.UltCB_code/UltimateMode": "Giant",
                "HasMod": "bobkalonger.UltCB_code"
            }
        },
        {
            "Action": "Include",
            "FromFile": "data/moreUpgrades.json",
            "When": {
                "bobkalonger.UltCB_code/UltimateMode": "More Upgrades",
                "HasMod": "bobkalonger.UltCB_code"
            }
        },
        {
            "Action": "Include",
            "FromFile": "data/upgradeVanilla.json",
            "When": {
                "bobkalonger.UltCB_code/UltimateMode": "Vanilla",
                "HasMod": "bobkalonger.UltCB_code"
            }
        },
        {
            "Action": "EditData",
            "Target": "Data/FarmAnimals",
            "When": {
                "HasMod": "FlashShifter.StardewValleyExpandedCP"
            },
            "Fields": {
                "FlashShifter.StardewValleyExpandedCP_Camel": {
                    "UnlockCondition": "ANY \"BUILDINGS_CONSTRUCTED all FlashShifter.StardewValleyExpandedCP_PremiumBarn 1\" \"BUILDINGS_CONSTRUCTED all bobkalonger.UltimateCoopAndBarnCP_UltimateBarn 1\""
                },
                "FlashShifter.StardewValleyExpandedCP_Goose": {
                    "UnlockCondition": "ANY \"BUILDINGS_CONSTRUCTED all FlashShifter.StardewValleyExpandedCP_PremiumCoop 1\" \"BUILDINGS_CONSTRUCTED all bobkalonger.UltimateCoopAndBarnCP_UltimateCoop 1\""
                }
            }
        },
        {
            "Action": "EditData",
            "Target": "Data/Buildings",
            "When": {
                "HasMod": "FlashShifter.StardewValleyExpandedCP"
            },
            "TextOperations": [
                {
                    "Operation": "Append",
                    "Target": [
                        "Fields",
                        "FlashShifter.StardewValleyExpandedCP_PremiumBarn",
                        "BuildCondition"
                    ],
                    "Value": " \"BUILDINGS_CONSTRUCTED All Amichwan.More.upgrades_PremiumBarn\" \"BUILDINGS_CONSTRUCTED All jenf1.megacoopbarn_MegaBarn\" \"BUILDINGS_CONSTRUCTED All bobkalonger.UltimateCoopAndBarnCP_UltimateBarn\" \"BUILDINGS_CONSTRUCTED All bobkalonger.UltimateCoopAndBarnCP_SuperDenseBarn\"",
                    "Delimiter": ""
                },
                {
                    "Operation": "Append",
                    "Target": [
                        "Fields",
                        "FlashShifter.StardewValleyExpandedCP_PremiumCoop",
                        "BuildCondition"
                    ],
                    "Value": " \"BUILDINGS_CONSTRUCTED All Amichwan.More.upgrades_PremiumCoop\" \"BUILDINGS_CONSTRUCTED All jenf1.megacoopbarn_MegaCoop\" \"BUILDINGS_CONSTRUCTED All UncleArya.ResourceChickens.GiantCoop\" \"BUILDINGS_CONSTRUCTED All bobkalonger.UltimateCoopAndBarnCP_UltimateCoop\" \"BUILDINGS_CONSTRUCTED All bobkalonger.UltimateCoopAndBarnCP_SuperDenseCoop\"",
                    "Delimiter": ""
                }
            ]
        }
    ]
}